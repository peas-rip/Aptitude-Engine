# Question Metadata Engine - environment template
# Copy to .env and fill in real values. Never commit .env.

# Required
OPENAI_API_KEY=sk-...

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2

# Model routing (cost control: 4o-mini for cheap stages, 4o for complex)
MODEL_CLASSIFIER=gpt-4o-mini
MODEL_DIFFICULTY=gpt-4o-mini
MODEL_SOLUTION=gpt-4o
MODEL_FORMULA=gpt-4o-mini
MODEL_VALIDATOR=gpt-4o

# Batch processing
CHECKPOINT_INTERVAL=10
MAX_RETRIES=3

# Directories (defaults match container layout; override locally)
INPUT_DIR=./data/input
OUTPUT_DIR=./data/output
CHECKPOINT_DIR=./data/checkpoints
