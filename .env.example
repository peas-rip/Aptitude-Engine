# Question Metadata Engine - environment template
# Copy to .env and fill in real values. Never commit .env.

# LLM provider: gemini (free default) | groq (free) | openai | custom
QME_LLM_PROVIDER=gemini

# Required for the active provider (keys validated at call time, not import)
# Google Gemini free tier: https://aistudio.google.com/apikey (no card;
# ~5-30 req/min per model depending on model; free-tier prompts may be used
# by Google to improve products outside UK/CH/EEA)
GEMINI_API_KEY=AIza...
# Groq free tier: https://console.groq.com/keys (no card; ~1K req/day)
GROQ_API_KEY=gsk-...
# Optional paid fallback when QME_LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
# For QME_LLM_PROVIDER=custom (any OpenAI-compatible endpoint)
# CUSTOM_BASE_URL=https://...
# CUSTOM_API_KEY=...

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2

# Model routing (Gemini free tier; flash-lite has the highest free RPM and
# supports strict json_schema; gemini-3.8-flash is the heavier fallback)
MODEL_CLASSIFIER=gemini-3.5-flash-lite
MODEL_DIFFICULTY=gemini-3.5-flash-lite
MODEL_SOLUTION=gemini-3.5-flash-lite
MODEL_FORMULA=gemini-3.5-flash-lite
MODEL_VALIDATOR=gemini-3.5-flash-lite

# Gateway retries + batch processing
MAX_RETRIES=3
CHECKPOINT_INTERVAL=10

# Directories (defaults match container layout; override locally)
INPUT_DIR=./data/input
OUTPUT_DIR=./data/output
CHECKPOINT_DIR=./data/checkpoints
